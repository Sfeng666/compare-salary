{
  "name": "@sfeng666/compare-salary",
  "version": "0.3.0",
  "description": "Compare salary purchasing power with reproducible US location data",
  "type": "module",
  "license": "MIT",
  "repository": "github:Sfeng666/compare-salary",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/compare.mjs",
    "./model": "./src/model.mjs",
    "./locations": "./src/locations.mjs",
    "./taxes.py": "./src/taxes.py",
    "./local": "./src/local.mjs",
    "./contribute": "./src/contribute.mjs",
    "./research": "./src/research.mjs",
    "./tax-jurisdiction": "./src/tax-jurisdiction.mjs"
  },
  "bin": {
    "compare-salary": "./bin/compare-salary.mjs",
    "compare-salary-mcp": "./bin/mcp.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "audit:tax": "node scripts/audit-tax-coverage.mjs",
    "build": "node scripts/build-site.mjs",
    "serve": "node bin/compare-salary.mjs serve",
    "prepare": "npm run build"
  },
  "files": [
    "src",
    "bin",
    "data",
    "skills",
    "README.md",
    "LICENSE",
    "DATA_LICENSE.md",
    "requirements.txt",
    "dist",
    "scripts/build-site.mjs",
    "scripts/audit-tax-coverage.mjs",
    "app.mjs",
    "index.html",
    "style.css"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
